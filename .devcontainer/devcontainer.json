{
  "name": "ROS2 Humble",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/repo_root,type=bind",
  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig,type=bind,consistency=cached,readonly",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],
  "runArgs": ["--env=DISPLAY=${localEnv:DISPLAY}", "--env=LIBGL_ALWAYS_SOFTWARE=1"],
  "workspaceFolder": "/repo_root",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/repo_root/ros2_ws/.venv/bin/python",
        "python.venvPath": "/repo_root/ros2_ws",
        "ros.distro": "humble",
        "terminal.integrated.cwd": "/repo_root/ros2_ws"
      }
    }
  },
  "postCreateCommand": "rosdep update && rosdep install --from-paths /repo_root/ros2_ws/src --ignore-src -r -y && poetry install -C /repo_root/ros2_ws"
}